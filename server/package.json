{
  "name": "vietmythicalspeed-server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative backend for Viet Mythical Speed: accounts (password, guest, Google Play Games, Steam), server-side gacha and rewards.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
