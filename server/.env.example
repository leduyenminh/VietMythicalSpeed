# Copy to .env (or set real environment variables) – see docs/Backend.md.

# HTTP / HTTPS
PORT=8787
# Public HTTPS origin of this server, used for the Steam OpenID realm/return URL and HTTP->HTTPS redirects.
# Must start with https:// when NODE_ENV=production.
PUBLIC_URL=http://localhost:8787
# Set to 1 behind a reverse proxy (Caddy, nginx, a cloud load balancer) so the client IP comes from
# X-Forwarded-For and HTTPS is recognised from X-Forwarded-Proto.
TRUST_PROXY=0
# Option A – TLS terminated by this server: PEM certificate chain + key (e.g. Let's Encrypt fullchain.pem/privkey.pem).
# Renewed files are picked up automatically (checked every minute, or send SIGHUP).
TLS_CERT_FILE=
TLS_KEY_FILE=
# Plain-HTTP listener (usually 80) that redirects to PUBLIC_URL; 0 = off.
HTTP_REDIRECT_PORT=0
# certbot --webroot directory; its /.well-known/acme-challenge files are served on HTTP_REDIRECT_PORT.
ACME_WEBROOT=
# Reject API calls that didn't arrive over HTTPS. Defaults to 1 when NODE_ENV=production.
REQUIRE_HTTPS=

# Game versions
# Oldest game version (PlayerSettings "Version", e.g. 0.2.0) allowed to use the API; older builds are told to update.
MIN_CLIENT_VERSION=
# Where the "update required" button sends players, by platform.
UPDATE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.vietmythical.speed
UPDATE_URL_WINDOWS=
# Races played without a connection may be synced this many hours later.
OFFLINE_SYNC_MAX_AGE_HOURS=72

# Storage
DATABASE_PATH=./data/vms.sqlite
# Defaults to ../UnityClient/Assets/VietMythicalSpeed/Resources/Data (same JSON the game ships with).
GAME_DATA_DIR=

# Auth – REQUIRED in production: long random string (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=60

# Google Play Games Services v2 (server-side access): OAuth "Web application" client from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Steam: App ID + Web API publisher key (ticket verification for PC builds).
STEAM_APP_ID=
STEAM_PUBLISHER_KEY=
# Optional regular Web API key, used to fetch persona names for browser (OpenID) sign-ins.
STEAM_WEB_API_KEY=

# Steam in-game purchases (ISteamMicroTxn) use STEAM_APP_ID + STEAM_PUBLISHER_KEY above.
# 1 = ISteamMicroTxnSandbox while testing (no money moves).
STEAM_MICROTXN_SANDBOX=0

# Google Play purchases: package name + service-account JSON key with access to this app in the Play Console
# (Users and permissions: View financial data, Manage orders). Keep the key file out of the repository.
GOOGLE_PLAY_PACKAGE=com.vietmythical.speed
GOOGLE_SERVICE_ACCOUNT_FILE=
# How often to check Google Play refunds (voided purchases) and take the gold back; 0 = off.
GOOGLE_VOIDED_POLL_MINUTES=360

# Development only: a store that always says yes (POST /v1/purchases/fake). Refused when NODE_ENV=production.
PAYMENTS_FAKE=0

# Password-reset emails: resend | postmark | sendgrid (console prints codes to the log; development only).
EMAIL_PROVIDER=
# Sender verified with the provider, e.g. "Viet Mythical Speed <no-reply@your-domain.com>".
EMAIL_FROM=
EMAIL_API_KEY=

# Admin API (broadcast mail, support lookups, refund poll): 24+ random characters; empty = disabled.
ADMIN_TOKEN=
